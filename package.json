{
  "name": "research-crawler",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "worker": "node scripts/worker.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "app": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "backup:restore": "node scripts/restore.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "check:staged": "node scripts/check-change.mjs --staged",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "puppeteer-core": "25.16.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
